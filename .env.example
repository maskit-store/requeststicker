# Salin file ini menjadi ".env" (di folder yang sama dengan app.js), lalu isi nilainya.
# Bisa diedit lewat File Manager hosting. Setelah mengubah, klik "Restart" di menu Node.js hosting.

# Alamat publik aplikasi (dipakai untuk link file siap cetak di PDF & Purchase Request)
BASE_URL=https://sticker.sainsgo.com

# Password awal — HANYA dipakai saat database pertama kali dibuat. Setelah itu ganti lewat menu Profil / Pengguna.
ADMIN_PASSWORD=GantiPasswordAdmin!
DEFAULT_PASSWORD=GantiPasswordTim!

# Folder data permanen (database, file siap cetak, font). Sebaiknya DI LUAR folder aplikasi & public_html,
# agar tidak terhapus saat aplikasi di-upload ulang. Contoh untuk cPanel (ganti "username"):
# DATA_DIR=/home/username/sticker-data

# DARURAT — lupa password admin: isi baris di bawah, Restart aplikasi, login sebagai "admin" dengan password ini,
# lalu HAPUS baris ini dan Restart lagi.
# RESET_ADMIN_PASSWORD=PasswordBaruAdmin123
